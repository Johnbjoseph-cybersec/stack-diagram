{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stack-diagram-gallery",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "stack-diagram-gallery" }],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    { "name": "ACTION_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
  ],
  "vars": {
    "SUBMISSIONS": "open",
    "DAILY_LIMIT": "200",
    "DAILY_LIMIT_PER_IP": "5",
    "POW_BITS": "20",
    "AI_GATEWAY": "default",
    "SITE_URL": "https://stacks.caru.moe",
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "NEON_AUTH_BASE_URL",
      "NEON_AUTH_COOKIE_SECRET",
      "POW_SECRET",
      "IP_HASH_SECRET",
      "GITHUB_TOKEN",
      "TURNSTILE_SECRET",
      "TURNSTILE_SITE_KEY",
      "ADMIN_GITHUB_IDS",
    ],
  },
}
